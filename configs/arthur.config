# 京东云 亚瑟 AX1800 Pro = JDCloud RE-SS-01（IPQ6000，512M RAM，eMMC）
# 上游：LiBwrt/LibWrt 分支 25.12-nss（满血 NSS）
# 依据：LibWrt target/linux/qualcommax/image/ipq60xx.mk  Device/jdcloud_re-ss-01
#   DEVICE_MODEL := RE-SS-01, SOC := ipq6000；dts 为 ipq6000-re-ss-01.dts（ipq6018-512m.dtsi）
# NSS：由 target/linux/qualcommax/Makefile 和 ipq60xx/target.mk 的 DEFAULT_PACKAGES 自动带入。
# 注意：亚瑟仅 512 MB RAM。组网与 OpenClash 都编进固件，但不要同时开；
# OpenClash + Mihomo + Samba4 / NSS 同开时也会吃紧，不用时在「系统 → 启动项」停掉。
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
# CONFIG_PACKAGE_ksmbd-server is not set
# CONFIG_PACKAGE_luci-app-ksmbd is not set
CONFIG_PACKAGE_chrony=y
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-i18n-chrony-zh-cn=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
# OpenClash（必带；ImmortalWrt luci feed；内核运行时下载）
# 依赖会自动拉：dnsmasq-full、bash、curl、ca-bundle、ip-full、ruby、ruby-yaml、
#   kmod-inet-diag、kmod-nft-tproxy、kmod-tun、unzip、luci-compat
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_luci-app-openclash=y
# 组网 / 穿透（与精简后 x86 对齐的必带项；Tailscale LuCI 由 scripts/jd-extra-packages.sh 拉取）
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y
CONFIG_PACKAGE_luci-app-nps=y
CONFIG_PACKAGE_luci-i18n-nps-zh-cn=y
CONFIG_PACKAGE_luci-app-keepalived=y
CONFIG_PACKAGE_luci-i18n-keepalived-zh-cn=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_block-mount=y
# Prometheus 指标导出（lua 版，与 x86 相同；只选轻量采集器，亚瑟只有 512 MB 内存）
CONFIG_PACKAGE_prometheus-node-exporter-lua=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-nat_traffic=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-netstat=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-openwrt=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-thermal=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-uci_dhcp_host=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi_stations=y
# CONFIG_PACKAGE_prometheus-node-exporter-ucode is not set
CONFIG_CCACHE=y
