# 京东云 雅典娜 AX6600 = JDCloud RE-CS-02（IPQ6010 + QCN9074，1G RAM，eMMC）
# 上游：LiBwrt/LibWrt 分支 25.12-nss（满血 NSS）
# 依据：LibWrt target/linux/qualcommax/image/ipq60xx.mk  Device/jdcloud_re-cs-02
#   DEVICE_MODEL := RE-CS-02, SOC := ipq6010, DEVICE_PACKAGES 含 ath11k-firmware-qcn9074
# 注意：本仓库早期版本误用了 jdcloud_re-ss-01（那是亚瑟 AX1800 Pro），已更正。
# NSS：选中 TARGET_qualcommax_ipq60xx 后由 target/linux/qualcommax/Makefile 和
#   ipq60xx/target.mk 的 DEFAULT_PACKAGES（kmod-qca-nss-drv、kmod-qca-nss-ecm、
#   nss-firmware-ipq60xx、kmod-qca-nss-crypto 等）自动带入，无需在此重复勾选。
# 组网（WireGuard / Tailscale）与 OpenClash 都编进固件，
# 但运行时不要同时开组网透明代理和 OpenClash，否则规则会打架、内存也更紧。
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
# CONFIG_PACKAGE_ksmbd-server is not set
# CONFIG_PACKAGE_luci-app-ksmbd is not set
CONFIG_PACKAGE_chrony=y
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-i18n-chrony-zh-cn=y
# OpenClash（必带；ImmortalWrt luci feed；内核运行时下载）
# 依赖会自动拉：dnsmasq-full、bash、curl、ca-bundle、ip-full、ruby、ruby-yaml、
#   kmod-inet-diag、kmod-nft-tproxy、kmod-tun、unzip、luci-compat
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_luci-app-openclash=y
# 组网（WireGuard / Tailscale；Tailscale LuCI 由 scripts/jd-extra-packages.sh 拉取）
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_block-mount=y
# Prometheus 指标导出（lua 版，与 x86 相同；只选轻量采集器）
CONFIG_PACKAGE_prometheus-node-exporter-lua=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-nat_traffic=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-netstat=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-openwrt=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-thermal=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-uci_dhcp_host=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi_stations=y
# CONFIG_PACKAGE_prometheus-node-exporter-ucode is not set
# ===== 以下为用户从 x86 勾选追加（2026-10-29）=====
# DNS：MosDNS（luci-app-mosdns 由 scripts/jd-extra-packages.sh 从 sbwml 拉取，与 x86 同源）
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y
# 组网：NAT 打洞 / 端口映射
CONFIG_PACKAGE_luci-app-natmap=y
CONFIG_PACKAGE_luci-i18n-natmap-zh-cn=y
# 防火墙 / 流量（pbr 和 mwan3 都做策略路由，规则别重叠；UPnP 的 miniupnpd 默认 enabled=0）
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-i18n-banip-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
# 存储 / 挂载（luci-app-diskman 硬依赖 parted、smartmontools、e2fsprogs，会自动带入）
CONFIG_PACKAGE_luci-app-cifs-mount=y
CONFIG_PACKAGE_luci-i18n-cifs-mount-zh-cn=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
# ntfs-3g（FUSE，挂载类型 ntfs-3g）和 kmod-fs-ntfs3（内核驱动，挂载类型 ntfs3）可并存
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_xfs-mkfs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_lvm2=y
CONFIG_PACKAGE_hdparm=y
# 监控
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
# 网络 / 命令行工具
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3-ssl=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_nload=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_drill=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_conntrackd=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_iotop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_rsyncd=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_speedtest-go=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_vim-full=y
# 按进程统计 IO（iotop 依赖 @KERNEL_TASKSTATS）
CONFIG_KERNEL_TASKSTATS=y
# 编译缓存（CCACHE 依赖 DEVEL，缺了 make defconfig 会清掉 CCACHE）
CONFIG_DEVEL=y
CONFIG_CCACHE=y
