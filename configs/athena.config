# 京东云 RE-SS-01（仓库内沿用此 device id）
# 上游：LiBwrt/LibWrt 分支 25.12-nss（满血 NSS）
# NSS：选中 TARGET_qualcommax_ipq60xx 后由 LibWrt
#   target/linux/qualcommax/ipq60xx/target.mk 的 DEFAULT_PACKAGES
#   （nss-firmware-ipq60xx、kmod-qca-nss-crypto 等）自动带入，无需在此重复勾选。
# 同系列另有 jdcloud_re-cs-02（IPQ6010 + QCN9074），若你的硬件是 CS-02 请改 DEVICE 行。
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_CCACHE=y
