# ===== 目标：x86_64 旁路由（Intel 3965U / 16G / 64G / 核显 i915），源码 ImmortalWrt master =====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_PARTSIZE=4096
CONFIG_GRUB_EFI_IMAGES=y
# 编译缓存（CCACHE 依赖 DEVEL）
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# LuCI 简体中文（不开这个，所有 luci-i18n-*-zh-cn 都会被 defconfig 丢掉）
CONFIG_LUCI_LANG_zh_Hans=y

# ===== 系统与界面 =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# ImmortalWrt 国内默认设置：时区 Asia/Shanghai、国内 NTP 和软件源镜像
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_bash=y

# ===== 核显 / CPU =====
CONFIG_PACKAGE_kmod-drm-i915=y
CONFIG_PACKAGE_i915-firmware-dmc=y
CONFIG_PACKAGE_i915-firmware-guc=y
CONFIG_PACKAGE_i915-firmware-huc=y
CONFIG_PACKAGE_intel-microcode=y

# ===== 磁盘与挂载（首次开机自动分区并挂载 /opt/data 依赖 parted、e2fsprogs、block-mount、kmod-fs-ext4）=====
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ===== DNS（OpenClash / PassWall 需要 dnsmasq-full，去掉精简版 dnsmasq 避免冲突）=====
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

# ===== 代理（均为 nftables / firewall4 版本）=====
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# ===== 组网 / VPN =====
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ===== 流量控制 / 多线 =====
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# ===== 共享（SMB 改用 samba4，不再装 ksmbd；两者都占 445 端口，显式关掉 ksmbd 防止被带回来）=====
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_samba4-server=y
# CONFIG_PACKAGE_luci-app-ksmbd is not set
# CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn is not set
# CONFIG_PACKAGE_ksmbd-server is not set
CONFIG_PACKAGE_luci-app-nfs=y
CONFIG_PACKAGE_luci-i18n-nfs-zh-cn=y

# ===== Docker =====
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y

# ===== 下载 =====
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-i18n-aria2-zh-cn=y
CONFIG_PACKAGE_luci-app-qbittorrent=y
CONFIG_PACKAGE_luci-i18n-qbittorrent-zh-cn=y

# ===== 多媒体 / 开发 =====
CONFIG_PACKAGE_ffmpeg=y
CONFIG_PACKAGE_ffprobe=y
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y

# ===== 监控 / 统计 =====
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-i18n-netdata-zh-cn=y
# Prometheus 指标导出（lua 版，ImmortalWrt master 里维护更勤、采集器更全；不装 ucode 版，两者都占 9100）
CONFIG_PACKAGE_prometheus-node-exporter-lua=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-nat_traffic=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-netstat=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-openwrt=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-thermal=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-hwmon=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-uci_dhcp_host=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-textfile=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-snmp6=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-mwan3=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-filesystem=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-ethtool=y
# CONFIG_PACKAGE_prometheus-node-exporter-ucode is not set
# OpenClash / Mihomo 的 Prometheus exporter，监听 2112，自动读 OpenClash 面板端口和密码
CONFIG_PACKAGE_clash-exporter=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y

# ===== 网络工具 =====
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_iperf3-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_mtr-json=y

# ===== 守护 / 定时重启 =====
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# ===== DDNS / 内网穿透 / 证书 =====
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y

# ===== 代理（补充）=====
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
# sing-box 完整版固定带 NaiveProxy 出站（def_bool y），会把 libcronet（整套 Chromium 网络栈）和 gn 拉进编译，
# gn 要求 C++23，ubuntu-22.04 上的 clang 14 编不过；scripts/x86_64-extra-packages.sh 已把这个开关改成默认关，这里只是写明。
# CONFIG_PACKAGE_libcronet is not set

# ===== 网盘 / 文件管理 =====
CONFIG_PACKAGE_luci-app-openlist=y
CONFIG_PACKAGE_luci-i18n-openlist-zh-cn=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y
# luci-app-filebrowser 只是 LuCI 自带的文件浏览模块；独立的 Filebrowser 网页文件管理服务（默认关闭，端口 8989，用 uci 开启）
CONFIG_PACKAGE_filebrowser=y
# ===== 内核 / 驱动 =====
# BBR：kmod-tcp-bbr 自带 /etc/sysctl.d/12-tcp-bbr.conf，开机即设为默认拥塞控制（只影响本机发起的 TCP，不影响 SQM）
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-veth=y
# 802.1Q VLAN 已编进内核（CONFIG_VLAN_8021Q=y），没有单独的 kmod-8021q 包
# 网卡：Realtek 用 r8125/r8168 厂商驱动，不选 r8169（会抢同一批网卡）
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8168=y
# CONFIG_PACKAGE_kmod-r8169 is not set
# USB 网卡 / 手机 USB 共享网络（安卓 RNDIS/NCM，iPhone 需 ipheth + usbmuxd）
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-ata-ahci=y
# ===== 系统工具 =====
CONFIG_PACKAGE_irqbalance=y
# luci-app-cpufreq 依赖的 cpufreq 包只支持 ARM（@(arm||aarch64)），x86 不装；x86 由内核 intel_pstate 自动调频
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_findutils=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_diffutils=y
# zram 压缩内存当 swap（默认大小 = 内存的一半，可用 uci set system.@system[0].zram_size_mb 调，不要就 /etc/init.d/zram disable）
CONFIG_PACKAGE_zram-swap=y
# GNU coreutils：OpenWrt 没有 coreutils-full，按命令拆包，选常用的
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-cp=y
CONFIG_PACKAGE_coreutils-cut=y
CONFIG_PACKAGE_coreutils-date=y
CONFIG_PACKAGE_coreutils-dd=y
CONFIG_PACKAGE_coreutils-df=y
CONFIG_PACKAGE_coreutils-du=y
CONFIG_PACKAGE_coreutils-env=y
CONFIG_PACKAGE_coreutils-head=y
CONFIG_PACKAGE_coreutils-ls=y
CONFIG_PACKAGE_coreutils-md5sum=y
CONFIG_PACKAGE_coreutils-mktemp=y
CONFIG_PACKAGE_coreutils-mv=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-nproc=y
CONFIG_PACKAGE_coreutils-readlink=y
CONFIG_PACKAGE_coreutils-realpath=y
CONFIG_PACKAGE_coreutils-rm=y
CONFIG_PACKAGE_coreutils-seq=y
CONFIG_PACKAGE_coreutils-sha256sum=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_coreutils-split=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_coreutils-stdbuf=y
CONFIG_PACKAGE_coreutils-tail=y
CONFIG_PACKAGE_coreutils-tee=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_coreutils-touch=y
CONFIG_PACKAGE_coreutils-tr=y
CONFIG_PACKAGE_coreutils-truncate=y
CONFIG_PACKAGE_coreutils-uniq=y
CONFIG_PACKAGE_coreutils-wc=y
# ===== 网络诊断 =====
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_nload=y
# 命令行测速（speedtest.net 节点）：speedtest-go
CONFIG_PACKAGE_speedtest-go=y
# ===== 界面插件 =====
# UPnP：miniupnpd 默认 enabled=0，不会自动开
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
# ===== 硬件 / 底层 =====
CONFIG_PACKAGE_kmod-hwmon-coretemp=y
CONFIG_PACKAGE_kmod-i2c-i801=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
# ntfs-3g（用户态 FUSE，挂载类型 ntfs-3g）和 kmod-fs-ntfs3（内核驱动，挂载类型 ntfs3）不冲突，可并存
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_lvm2=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_bpftool-minimal=y
# ===== 网络（补充）=====
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
# pbr 和 mwan3 都做策略路由，两个都装了，规则别重叠
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y
CONFIG_PACKAGE_luci-app-eqos=y
CONFIG_PACKAGE_luci-i18n-eqos-zh-cn=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_luci-i18n-cloudflared-zh-cn=y
CONFIG_PACKAGE_luci-app-natmap=y
CONFIG_PACKAGE_luci-i18n-natmap-zh-cn=y
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-i18n-openvpn-server-zh-cn=y
# IPsec：ImmortalWrt 的 LuCI 版是 luci-app-ipsec-vpnd（strongswan）
CONFIG_PACKAGE_luci-app-ipsec-vpnd=y
CONFIG_PACKAGE_luci-i18n-ipsec-vpnd-zh-cn=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
CONFIG_PACKAGE_luci-app-omcproxy=y
CONFIG_PACKAGE_luci-i18n-omcproxy-zh-cn=y
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-i18n-banip-zh-cn=y
# ===== 存储 / 服务 =====
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
CONFIG_PACKAGE_luci-app-rclone=y
CONFIG_PACKAGE_luci-i18n-rclone-zh-cn=y
CONFIG_PACKAGE_luci-app-vsftpd=y
CONFIG_PACKAGE_luci-i18n-vsftpd-zh-cn=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_luci-i18n-minidlna-zh-cn=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-app-nut=y
CONFIG_PACKAGE_luci-i18n-nut-zh-cn=y
# 常见 USB 接口 UPS（APC、山特等 HID 协议）的驱动
CONFIG_PACKAGE_nut-driver-usbhid-ups=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
# ===== daed（eBPF 透明代理）需要的内核 / 工具链选项 =====
# 内核带 BTF 类型信息（BPF CO-RE 需要）；需要完整调试信息，不能用 REDUCED
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y
# eBPF 程序用宿主机的 clang/llvm 编译（workflow 已 apt 安装 clang、llvm），省去现编 LLVM 的一个多小时
CONFIG_BPF_TOOLCHAIN_HOST=y
# ===== 代理 / 分流（补充）=====
# daed：eBPF 透明代理 + 网页面板，和 OpenClash / PassWall / HomeProxy 同一时间只开一个
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y
# ===== 家长控制 / 应用过滤 =====
# OpenAppFilter（应用过滤）：需要关闭防火墙的软件/硬件流量卸载才能识别
CONFIG_PACKAGE_luci-app-appfilter=y
CONFIG_PACKAGE_luci-i18n-appfilter-zh-cn=y
# 定时控制（第三方 gaobin89，中文翻译已内置在包里）
CONFIG_PACKAGE_luci-app-timecontrol=y
# ===== 通知 / 高可用 =====
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
CONFIG_PACKAGE_luci-app-keepalived=y
CONFIG_PACKAGE_luci-i18n-keepalived-zh-cn=y
# ===== 组网 / VPN（补充）=====
CONFIG_PACKAGE_luci-app-n2n=y
CONFIG_PACKAGE_luci-i18n-n2n-zh-cn=y
CONFIG_PACKAGE_luci-app-softethervpn=y
CONFIG_PACKAGE_luci-i18n-softethervpn-zh-cn=y
# 端口转发：ImmortalWrt 用 luci-app-3cat（3proxy）取代 luci-app-socat；socat 命令行另装
CONFIG_PACKAGE_luci-app-3cat=y
CONFIG_PACKAGE_luci-i18n-3cat-zh-cn=y
CONFIG_PACKAGE_socat=y
# ===== 同步 / 下载 / 文件服务（补充）=====
CONFIG_PACKAGE_luci-app-syncthing=y
CONFIG_PACKAGE_luci-i18n-syncthing-zh-cn=y
CONFIG_PACKAGE_luci-app-transmission=y
CONFIG_PACKAGE_luci-i18n-transmission-zh-cn=y
# WebDAV：ImmortalWrt 没有 luci-app-webdav，用 dufs（文件服务器，支持 WebDAV）
CONFIG_PACKAGE_luci-app-dufs=y
CONFIG_PACKAGE_luci-i18n-dufs-zh-cn=y
# ===== 娱乐 =====
# 解锁网易云灰色歌曲：依赖 node（要从源码交叉编译 Node.js，编译时间明显变长）；界面本身就是中文，没有单独的中文包
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
# ===== 代理（补充二）=====
# v2rayA：v2ray/xray 网页客户端；Nikki：mihomo 透明代理（第三方 nikkinikki-org，内核用稳定版 mihomo-meta）
# 和 OpenClash / PassWall / HomeProxy / daed 一样，同一时间只开一个
CONFIG_PACKAGE_luci-app-v2raya=y
CONFIG_PACKAGE_luci-i18n-v2raya-zh-cn=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo-meta=y
# ===== 广告过滤 / 防检测 =====
# adblock-fast：基于 dnsmasq 的广告过滤，和 AdGuard Home 二选一用
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn=y
# UA2F：改写 HTTP User-Agent（校园网防多设备检测）
CONFIG_PACKAGE_luci-app-ua2f=y
CONFIG_PACKAGE_luci-i18n-ua2f-zh-cn=y
# ===== 内网穿透（补充）=====
# NPS 客户端（npc）
CONFIG_PACKAGE_luci-app-nps=y
CONFIG_PACKAGE_luci-i18n-nps-zh-cn=y
# ===== 流量统计 / 网络存储（补充）=====
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_luci-i18n-vnstat2-zh-cn=y
# 挂载远程 SMB/CIFS 共享
CONFIG_PACKAGE_luci-app-cifs-mount=y
CONFIG_PACKAGE_luci-i18n-cifs-mount-zh-cn=y
# ===== 4G/5G 蜂窝模块（USB 上网卡 / M.2 模块）=====
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
# 命令行调试工具（ModemManager 自己用 libqmi/libmbim，这两个只是备用）
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
# ===== 内核选项（监控 / 排障）=====
# 内存、CPU、IO 压力统计（/proc/pressure），容器监控用
CONFIG_KERNEL_PSI=y
# 按进程统计 IO（iotop 依赖；同时打开 TASK_DELAY_ACCT / TASK_IO_ACCOUNTING / TASK_XACCT）
CONFIG_KERNEL_TASKSTATS=y
# 检测卡死的任务和软死锁，方便查死机
CONFIG_KERNEL_DETECT_HUNG_TASK=y
CONFIG_KERNEL_SOFTLOCKUP_DETECTOR=y
# 按 cgroup 给流量打标记（net_cls），分流 / 限速用
CONFIG_KERNEL_CGROUP_NET_CLASSID=y
# zram 支持 zstd 并设为内核默认压缩算法（保留 lzo 作为兜底）；首次开机脚本 97-zram-zstd 让 zram-swap 实际用 zstd
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_BACKEND_ZSTD=y
CONFIG_KERNEL_ZRAM_DEF_COMP_ZSTD=y
# ===== 内核模块：流控 / 隧道 / nftables 扩展 =====
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-ctinfo=y
CONFIG_PACKAGE_kmod-sched-connmark=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-drr=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-netem=y
# 多网口聚合
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_proto-bonding=y
# FTP / SIP / PPTP / H.323 等 NAT 辅助
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-ipvlan=y
CONFIG_PACKAGE_kmod-vrf=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-nft-arp=y
# 内核 TLS
CONFIG_PACKAGE_kmod-tls=y
# ===== 内核模块：存储 / 5G =====
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-nbd=y
CONFIG_PACKAGE_kmod-fs-autofs4=y
# PCIe 5G 模块：高通 MHI、联发科 T700（kmod-wwan 是它们的公共依赖）
CONFIG_PACKAGE_kmod-wwan=y
CONFIG_PACKAGE_kmod-mhi-net=y
CONFIG_PACKAGE_kmod-mhi-wwan-ctrl=y
CONFIG_PACKAGE_kmod-mtk-t7xx=y
# ===== 系统 / 调试工具 =====
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_gdb=y
CONFIG_PACKAGE_perf=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_iotop=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_vim-full=y
CONFIG_PACKAGE_zsh=y
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_file=y
# procps-ng：完整版 ps / top / free 等（通过 alternatives 覆盖 busybox 同名命令）
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-ps=y
CONFIG_PACKAGE_procps-ng-top=y
CONFIG_PACKAGE_procps-ng-free=y
CONFIG_PACKAGE_procps-ng-vmstat=y
CONFIG_PACKAGE_procps-ng-watch=y
CONFIG_PACKAGE_procps-ng-pgrep=y
CONFIG_PACKAGE_procps-ng-pkill=y
CONFIG_PACKAGE_procps-ng-pmap=y
CONFIG_PACKAGE_procps-ng-pwdx=y
CONFIG_PACKAGE_procps-ng-slabtop=y
CONFIG_PACKAGE_procps-ng-uptime=y
CONFIG_PACKAGE_procps-ng-w=y
CONFIG_PACKAGE_git=y
CONFIG_PACKAGE_git-http=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_rsyncd=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_dmidecode=y
# acpid 依赖 input-support（输入设备支持开关），要一起选上
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_acpid=y
CONFIG_PACKAGE_kexec-tools=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_xfs-mkfs=y
# ===== 网络工具 =====
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_ncat=y
CONFIG_PACKAGE_drill=y
# tc-full 和 SQM 带进来的 tc-tiny 通过 alternatives 共存，/sbin/tc 指向 tc-full（优先级更高）
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_conntrackd=y
CONFIG_PACKAGE_ipvsadm=y
# ===== LuCI 插件（补充三）=====
# 4G/5G 配套：信号信息、锁频段、收发短信
CONFIG_PACKAGE_luci-app-3ginfo-lite=y
CONFIG_PACKAGE_luci-i18n-3ginfo-lite-zh-cn=y
CONFIG_PACKAGE_luci-app-modemband=y
CONFIG_PACKAGE_luci-i18n-modemband-zh-cn=y
CONFIG_PACKAGE_luci-app-sms-tool-js=y
CONFIG_PACKAGE_luci-i18n-sms-tool-js-zh-cn=y
# 系统
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_luci-i18n-irqbalance-zh-cn=y
# chrony 接管时间同步（首次开机脚本 99-zz-chrony-ntp 关掉 busybox sysntpd，换国内 NTP 服务器）
CONFIG_PACKAGE_chrony=y
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-i18n-chrony-zh-cn=y
CONFIG_PACKAGE_luci-app-cpulimit=y
CONFIG_PACKAGE_luci-i18n-cpulimit-zh-cn=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
# 网络服务端 / DNS
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_luci-i18n-https-dns-proxy-zh-cn=y
# unbound 默认改到 5335 端口并关闭（53 端口留给 dnsmasq），见 97-x86-service-defaults
CONFIG_PACKAGE_luci-app-unbound=y
CONFIG_PACKAGE_luci-i18n-unbound-zh-cn=y
# 其他
CONFIG_PACKAGE_luci-app-qosify=y
CONFIG_PACKAGE_luci-i18n-qosify-zh-cn=y
# 多拨（依赖 mwan3 + macvlan；界面本身是中文，没有单独的中文包）
CONFIG_PACKAGE_luci-app-syncdial=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y
CONFIG_PACKAGE_luci-app-gost=y
CONFIG_PACKAGE_luci-i18n-gost-zh-cn=y
CONFIG_PACKAGE_luci-app-microsocks=y
CONFIG_PACKAGE_luci-i18n-microsocks-zh-cn=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y
# AirPlay 2 已移除：ImmortalWrt 的 shairport-sync 4.3.6 和新版 FFmpeg 编译不过（AVCodec.sample_fmts 已删除）
# CONFIG_PACKAGE_luci-app-airplay2 is not set
# CONFIG_PACKAGE_luci-i18n-airplay2-zh-cn is not set
# CONFIG_PACKAGE_shairport-sync-openssl is not set
# CONFIG_PACKAGE_shairport-sync-mbedtls is not set
# CONFIG_PACKAGE_shairport-sync-mini is not set
CONFIG_PACKAGE_luci-app-mosquitto=y
CONFIG_PACKAGE_luci-i18n-mosquitto-zh-cn=y
# 只装防火墙封禁端（bouncer），不含 CrowdSec 引擎，需要另外有一个 CrowdSec 本地 API
CONFIG_PACKAGE_luci-app-crowdsec-firewall-bouncer=y
CONFIG_PACKAGE_luci-i18n-crowdsec-firewall-bouncer-zh-cn=y
CONFIG_PACKAGE_luci-app-snmpd=y
CONFIG_PACKAGE_luci-i18n-snmpd-zh-cn=y
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_luci-i18n-lldpd-zh-cn=y
