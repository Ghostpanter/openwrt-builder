# ===== 目标：x86_64 旁路由（Intel 3965U / 16G / 64G / 核显 i915），源码 ImmortalWrt master =====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_PARTSIZE=4096
CONFIG_GRUB_EFI_IMAGES=y
# 编译缓存（CCACHE 依赖 DEVEL）
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# LuCI 简体中文（不开这个，所有 luci-i18n-*-zh-cn 都会被 defconfig 丢掉）
CONFIG_LUCI_LANG_zh_Hans=y

# ===== 系统与界面 =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# ImmortalWrt 国内默认设置：时区 Asia/Shanghai、国内 NTP 和软件源镜像
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_bash=y

# ===== 核显 / CPU =====
CONFIG_PACKAGE_kmod-drm-i915=y
CONFIG_PACKAGE_i915-firmware-dmc=y
CONFIG_PACKAGE_i915-firmware-guc=y
CONFIG_PACKAGE_i915-firmware-huc=y
CONFIG_PACKAGE_intel-microcode=y

# ===== 磁盘与挂载（首次开机自动分区并挂载 /opt/data 依赖 parted、e2fsprogs、block-mount、kmod-fs-ext4）=====
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ===== DNS（OpenClash 需要 dnsmasq-full，去掉精简版 dnsmasq 避免冲突；只留 MosDNS）=====
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn is not set
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

# ===== 代理（只留 OpenClash；PassWall / HomeProxy / Nikki / v2rayA 已移除）=====
CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set

# ===== 组网 / VPN =====
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y
# CONFIG_PACKAGE_luci-app-zerotier is not set
# CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn is not set

# ===== 流量控制 / 多线 =====
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# ===== 共享（Samba / NFS / FTP 已移除；显式关掉 ksmbd）=====
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-i18n-samba4-zh-cn is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-ksmbd is not set
# CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn is not set
# CONFIG_PACKAGE_ksmbd-server is not set
# CONFIG_PACKAGE_luci-app-nfs is not set
# CONFIG_PACKAGE_luci-i18n-nfs-zh-cn is not set

# ===== Docker（已移除）=====
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_docker-compose is not set

# ===== 下载（aria2 / qBittorrent / Transmission 已移除）=====
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-i18n-aria2-zh-cn is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
# CONFIG_PACKAGE_luci-i18n-qbittorrent-zh-cn is not set

# ===== 多媒体 / 开发（ffmpeg / python 已移除）=====
# CONFIG_PACKAGE_ffmpeg is not set
# CONFIG_PACKAGE_ffprobe is not set
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_python3-pip is not set

# ===== 监控 / 统计 =====
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
# CONFIG_PACKAGE_luci-app-netdata is not set
# CONFIG_PACKAGE_luci-i18n-netdata-zh-cn is not set
# Prometheus node exporter 已移除（减体积、省编译）
# CONFIG_PACKAGE_prometheus-node-exporter-lua is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-nat_traffic is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-netstat is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-openwrt is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-thermal is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-hwmon is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-uci_dhcp_host is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-textfile is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-snmp6 is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-mwan3 is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-filesystem is not set
# CONFIG_PACKAGE_prometheus-node-exporter-lua-ethtool is not set
# CONFIG_PACKAGE_prometheus-node-exporter-ucode is not set
# OpenClash / Mihomo 的 Prometheus exporter，监听 2112，自动读 OpenClash 面板端口和密码
CONFIG_PACKAGE_clash-exporter=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y

# ===== 网络工具 =====
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_iperf3-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_mtr-json=y

# ===== 守护 / 定时重启 =====
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# ===== DDNS / 内网穿透 / 证书（留官方 ddns + frp/nps；ddns-go / lucky 已移除）=====
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn is not set
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_luci-i18n-lucky-zh-cn is not set
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y

# ===== 代理（补充：HomeProxy 已移除）=====
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn is not set
# sing-box 完整版固定带 NaiveProxy 出站（def_bool y），会把 libcronet（整套 Chromium 网络栈）和 gn 拉进编译，
# gn 要求 C++23，ubuntu-22.04 上的 clang 14 编不过；scripts/x86_64-extra-packages.sh 已把这个开关改成默认关，这里只是写明。
# CONFIG_PACKAGE_libcronet is not set

# ===== 网盘 / 文件管理（openlist / filebrowser / filemanager / dufs 已移除）=====
# CONFIG_PACKAGE_luci-app-openlist is not set
# CONFIG_PACKAGE_luci-i18n-openlist-zh-cn is not set
# CONFIG_PACKAGE_luci-app-filebrowser is not set
# CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn is not set
# luci-app-filebrowser 只是 LuCI 自带的文件浏览模块；独立的 Filebrowser 网页文件管理服务（默认关闭，端口 8989，用 uci 开启）
# CONFIG_PACKAGE_filebrowser is not set
# ===== 内核 / 驱动 =====
# BBR：kmod-tcp-bbr 自带 /etc/sysctl.d/12-tcp-bbr.conf，开机即设为默认拥塞控制（只影响本机发起的 TCP，不影响 SQM）
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-veth=y
# 802.1Q VLAN 已编进内核（CONFIG_VLAN_8021Q=y），没有单独的 kmod-8021q 包
# 网卡：Realtek 用 r8125/r8168 厂商驱动，不选 r8169（会抢同一批网卡）
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8168=y
# CONFIG_PACKAGE_kmod-r8169 is not set
# USB 网卡 / 手机 USB 共享网络（安卓 RNDIS/NCM，iPhone 需 ipheth + usbmuxd）
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-ata-ahci=y
# ===== 系统工具 =====
CONFIG_PACKAGE_irqbalance=y
# luci-app-cpufreq 依赖的 cpufreq 包只支持 ARM（@(arm||aarch64)），x86 不装；x86 由内核 intel_pstate 自动调频
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_findutils=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_diffutils=y
# zram 压缩内存当 swap（默认大小 = 内存的一半，可用 uci set system.@system[0].zram_size_mb 调，不要就 /etc/init.d/zram disable）
CONFIG_PACKAGE_zram-swap=y
# GNU coreutils：OpenWrt 没有 coreutils-full，按命令拆包，选常用的
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-cp=y
CONFIG_PACKAGE_coreutils-cut=y
CONFIG_PACKAGE_coreutils-date=y
CONFIG_PACKAGE_coreutils-dd=y
CONFIG_PACKAGE_coreutils-df=y
CONFIG_PACKAGE_coreutils-du=y
CONFIG_PACKAGE_coreutils-env=y
CONFIG_PACKAGE_coreutils-head=y
CONFIG_PACKAGE_coreutils-ls=y
CONFIG_PACKAGE_coreutils-md5sum=y
CONFIG_PACKAGE_coreutils-mktemp=y
CONFIG_PACKAGE_coreutils-mv=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-nproc=y
CONFIG_PACKAGE_coreutils-readlink=y
CONFIG_PACKAGE_coreutils-realpath=y
CONFIG_PACKAGE_coreutils-rm=y
CONFIG_PACKAGE_coreutils-seq=y
CONFIG_PACKAGE_coreutils-sha256sum=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_coreutils-split=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_coreutils-stdbuf=y
CONFIG_PACKAGE_coreutils-tail=y
CONFIG_PACKAGE_coreutils-tee=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_coreutils-touch=y
CONFIG_PACKAGE_coreutils-tr=y
CONFIG_PACKAGE_coreutils-truncate=y
CONFIG_PACKAGE_coreutils-uniq=y
CONFIG_PACKAGE_coreutils-wc=y
# ===== 网络诊断 =====
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_nload=y
# 命令行测速（speedtest.net 节点）：speedtest-go
CONFIG_PACKAGE_speedtest-go=y
# ===== 界面插件 =====
# UPnP：miniupnpd 默认 enabled=0，不会自动开
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
# CONFIG_PACKAGE_luci-app-filemanager is not set
# CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn is not set
# ===== 硬件 / 底层 =====
CONFIG_PACKAGE_kmod-hwmon-coretemp=y
CONFIG_PACKAGE_kmod-i2c-i801=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
# ntfs-3g（用户态 FUSE，挂载类型 ntfs-3g）和 kmod-fs-ntfs3（内核驱动，挂载类型 ntfs3）不冲突，可并存
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_lvm2=y
CONFIG_PACKAGE_kmod-sched-bpf=y
# CONFIG_PACKAGE_bpftool-minimal is not set
# ===== 网络（补充）=====
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn is not set
# pbr 和 mwan3 都做策略路由，两个都装了，规则别重叠
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y
# CONFIG_PACKAGE_luci-app-eqos is not set
# CONFIG_PACKAGE_luci-i18n-eqos-zh-cn is not set
# CONFIG_PACKAGE_luci-app-easytier is not set
# CONFIG_PACKAGE_luci-i18n-easytier-zh-cn is not set
# CONFIG_PACKAGE_easytier is not set
# CONFIG_PACKAGE_luci-app-cloudflared is not set
# CONFIG_PACKAGE_luci-i18n-cloudflared-zh-cn is not set
CONFIG_PACKAGE_luci-app-natmap=y
CONFIG_PACKAGE_luci-i18n-natmap-zh-cn=y
# CONFIG_PACKAGE_luci-app-openvpn-server is not set
# CONFIG_PACKAGE_luci-i18n-openvpn-server-zh-cn is not set
# IPsec（luci-app-ipsec-vpnd / strongSwan）已移除
# CONFIG_PACKAGE_luci-app-ipsec-vpnd is not set
# CONFIG_PACKAGE_luci-i18n-ipsec-vpnd-zh-cn is not set
# CONFIG_PACKAGE_luci-app-udpxy is not set
# CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn is not set
# CONFIG_PACKAGE_luci-app-msd_lite is not set
# CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn is not set
# CONFIG_PACKAGE_luci-app-omcproxy is not set
# CONFIG_PACKAGE_luci-i18n-omcproxy-zh-cn is not set
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-i18n-banip-zh-cn=y
# ===== 存储 / 服务 =====
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
CONFIG_PACKAGE_luci-app-rclone=y
CONFIG_PACKAGE_luci-i18n-rclone-zh-cn=y
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-i18n-vsftpd-zh-cn is not set
# CONFIG_PACKAGE_luci-app-minidlna is not set
# CONFIG_PACKAGE_luci-i18n-minidlna-zh-cn is not set
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
# CONFIG_PACKAGE_luci-app-nut is not set
# CONFIG_PACKAGE_luci-i18n-nut-zh-cn is not set
# 常见 USB 接口 UPS（APC、山特等 HID 协议）的驱动
# CONFIG_PACKAGE_nut-driver-usbhid-ups is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn is not set
# ===== 内核 eBPF 相关（daed / qosify 已移除，不再开 BTF 完整调试信息）=====
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y
# daed / qosify 已移除，不再需要宿主机 clang 编 eBPF
# CONFIG_BPF_TOOLCHAIN_HOST is not set
# ===== 代理 / 分流（补充）=====
# daed 已移除（曾为 eBPF 透明代理）
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_luci-i18n-daed-zh-cn is not set
# ===== 家长控制 / 应用过滤（appfilter 已移除；timecontrol 暂留）=====
# OpenAppFilter（应用过滤）：需要关闭防火墙的软件/硬件流量卸载才能识别
# CONFIG_PACKAGE_luci-app-appfilter is not set
# CONFIG_PACKAGE_luci-i18n-appfilter-zh-cn is not set
# 定时控制（第三方 gaobin89，中文翻译已内置在包里）
CONFIG_PACKAGE_luci-app-timecontrol=y
# ===== 通知 / 高可用 =====
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
CONFIG_PACKAGE_luci-app-keepalived=y
CONFIG_PACKAGE_luci-i18n-keepalived-zh-cn=y
# ===== 组网 / VPN（补充：n2n / SoftEther 已移除；保留 keepalived）=====
# CONFIG_PACKAGE_luci-app-n2n is not set
# CONFIG_PACKAGE_luci-i18n-n2n-zh-cn is not set
# CONFIG_PACKAGE_luci-app-softethervpn is not set
# CONFIG_PACKAGE_luci-i18n-softethervpn-zh-cn is not set
# 端口转发：ImmortalWrt 用 luci-app-3cat（3proxy）取代 luci-app-socat；socat 命令行另装
# CONFIG_PACKAGE_luci-app-3cat is not set
# CONFIG_PACKAGE_luci-i18n-3cat-zh-cn is not set
CONFIG_PACKAGE_socat=y
# ===== 同步 / 文件服务（保留 Syncthing；Transmission / dufs 已移除）=====
CONFIG_PACKAGE_luci-app-syncthing=y
CONFIG_PACKAGE_luci-i18n-syncthing-zh-cn=y
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-i18n-transmission-zh-cn is not set
# WebDAV：ImmortalWrt 没有 luci-app-webdav，用 dufs（文件服务器，支持 WebDAV）
# CONFIG_PACKAGE_luci-app-dufs is not set
# CONFIG_PACKAGE_luci-i18n-dufs-zh-cn is not set
# ===== 娱乐 =====
# 网易云解锁已去掉：交叉编译 node 极易 OOM、耗时长；需要时刷机后单独装 ipk / 用 Docker，勿再编进固件
# CONFIG_PACKAGE_luci-app-unblockneteasemusic is not set
# CONFIG_PACKAGE_node is not set
# CONFIG_PACKAGE_node-npm is not set
# ===== 代理（补充二：v2rayA / Nikki / mihomo-meta 已移除，只留 OpenClash）=====
# CONFIG_PACKAGE_luci-app-v2raya is not set
# CONFIG_PACKAGE_luci-i18n-v2raya-zh-cn is not set
# CONFIG_PACKAGE_luci-app-nikki is not set
# CONFIG_PACKAGE_luci-i18n-nikki-zh-cn is not set
# CONFIG_PACKAGE_mihomo-meta is not set
# ===== 广告过滤 / 防检测（adblock-fast / ua2f 已移除）=====
# CONFIG_PACKAGE_luci-app-adblock-fast is not set
# CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn is not set
# UA2F：改写 HTTP User-Agent（校园网防多设备检测）
# CONFIG_PACKAGE_luci-app-ua2f is not set
# CONFIG_PACKAGE_luci-i18n-ua2f-zh-cn is not set
# ===== 内网穿透（补充）=====
# NPS 客户端（npc）
CONFIG_PACKAGE_luci-app-nps=y
CONFIG_PACKAGE_luci-i18n-nps-zh-cn=y
# ===== 流量统计 / 网络存储（补充）=====
# CONFIG_PACKAGE_luci-app-vnstat2 is not set
# CONFIG_PACKAGE_luci-i18n-vnstat2-zh-cn is not set
# 挂载远程 SMB/CIFS 共享
CONFIG_PACKAGE_luci-app-cifs-mount=y
CONFIG_PACKAGE_luci-i18n-cifs-mount-zh-cn=y
# ===== 4G/5G 蜂窝模块（已移除）=====
# CONFIG_PACKAGE_luci-proto-modemmanager is not set
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_kmod-usb-serial-option is not set
# CONFIG_PACKAGE_kmod-usb-acm is not set
# CONFIG_PACKAGE_kmod-usb-wdm is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-mbim is not set
# CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm is not set
# 命令行调试工具（ModemManager 自己用 libqmi/libmbim，这两个只是备用）
# CONFIG_PACKAGE_uqmi is not set
# CONFIG_PACKAGE_umbim is not set
# ===== 内核选项（监控 / 排障）=====
# 内存、CPU、IO 压力统计（/proc/pressure），容器监控用
CONFIG_KERNEL_PSI=y
# 按进程统计 IO（iotop 依赖；同时打开 TASK_DELAY_ACCT / TASK_IO_ACCOUNTING / TASK_XACCT）
CONFIG_KERNEL_TASKSTATS=y
# 检测卡死的任务和软死锁，方便查死机
CONFIG_KERNEL_DETECT_HUNG_TASK=y
CONFIG_KERNEL_SOFTLOCKUP_DETECTOR=y
# 按 cgroup 给流量打标记（net_cls），分流 / 限速用
CONFIG_KERNEL_CGROUP_NET_CLASSID=y
# zram 支持 zstd 并设为内核默认压缩算法（保留 lzo 作为兜底）；首次开机脚本 97-zram-zstd 让 zram-swap 实际用 zstd
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_BACKEND_ZSTD=y
CONFIG_KERNEL_ZRAM_DEF_COMP_ZSTD=y
# ===== 内核模块：流控 / 隧道 / nftables 扩展 =====
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-ctinfo=y
CONFIG_PACKAGE_kmod-sched-connmark=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-drr=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-netem=y
# 多网口聚合
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_proto-bonding=y
# FTP / SIP / PPTP / H.323 等 NAT 辅助
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-ipvlan=y
CONFIG_PACKAGE_kmod-vrf=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-nft-arp=y
# 内核 TLS
CONFIG_PACKAGE_kmod-tls=y
# ===== 内核模块：存储（PCIe 5G 模块已移除）=====
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-nbd=y
CONFIG_PACKAGE_kmod-fs-autofs4=y
# PCIe 5G 模块：高通 MHI、联发科 T700（kmod-wwan 是它们的公共依赖）
# CONFIG_PACKAGE_kmod-wwan is not set
# CONFIG_PACKAGE_kmod-mhi-net is not set
# CONFIG_PACKAGE_kmod-mhi-wwan-ctrl is not set
# CONFIG_PACKAGE_kmod-mtk-t7xx is not set
# ===== 系统 / 调试工具 =====
# CONFIG_PACKAGE_strace is not set
# CONFIG_PACKAGE_gdb is not set
# CONFIG_PACKAGE_perf is not set
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_iotop=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_vim-full=y
# CONFIG_PACKAGE_zsh is not set
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_file=y
# procps-ng：完整版 ps / top / free 等（通过 alternatives 覆盖 busybox 同名命令）
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-ps=y
CONFIG_PACKAGE_procps-ng-top=y
CONFIG_PACKAGE_procps-ng-free=y
CONFIG_PACKAGE_procps-ng-vmstat=y
CONFIG_PACKAGE_procps-ng-watch=y
CONFIG_PACKAGE_procps-ng-pgrep=y
CONFIG_PACKAGE_procps-ng-pkill=y
CONFIG_PACKAGE_procps-ng-pmap=y
CONFIG_PACKAGE_procps-ng-pwdx=y
CONFIG_PACKAGE_procps-ng-slabtop=y
CONFIG_PACKAGE_procps-ng-uptime=y
CONFIG_PACKAGE_procps-ng-w=y
CONFIG_PACKAGE_git=y
CONFIG_PACKAGE_git-http=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_rsyncd=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_dmidecode=y
# acpid 依赖 input-support（输入设备支持开关），要一起选上
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_acpid=y
# CONFIG_PACKAGE_kexec-tools is not set
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_xfs-mkfs=y
# ===== 网络工具 =====
# CONFIG_PACKAGE_nmap is not set
CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_ncat=y
CONFIG_PACKAGE_drill=y
# tc-full 和 SQM 带进来的 tc-tiny 通过 alternatives 共存，/sbin/tc 指向 tc-full（优先级更高）
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_conntrackd=y
# CONFIG_PACKAGE_ipvsadm is not set
# ===== LuCI 插件（补充三；4G/5G 配套已移除）=====
# CONFIG_PACKAGE_luci-app-3ginfo-lite is not set
# CONFIG_PACKAGE_luci-i18n-3ginfo-lite-zh-cn is not set
# CONFIG_PACKAGE_luci-app-modemband is not set
# CONFIG_PACKAGE_luci-i18n-modemband-zh-cn is not set
# CONFIG_PACKAGE_luci-app-sms-tool-js is not set
# CONFIG_PACKAGE_luci-i18n-sms-tool-js-zh-cn is not set
# 系统
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_luci-i18n-irqbalance-zh-cn=y
# chrony 接管时间同步（首次开机脚本 99-zz-chrony-ntp 关掉 busybox sysntpd，换国内 NTP 服务器）
CONFIG_PACKAGE_chrony=y
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-i18n-chrony-zh-cn=y
# CONFIG_PACKAGE_luci-app-cpulimit is not set
# CONFIG_PACKAGE_luci-i18n-cpulimit-zh-cn is not set
# CONFIG_PACKAGE_luci-app-ramfree is not set
# CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn is not set
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
# 网络服务端 / DNS
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-i18n-frps-zh-cn=y
# CONFIG_PACKAGE_luci-app-https-dns-proxy is not set
# CONFIG_PACKAGE_luci-i18n-https-dns-proxy-zh-cn is not set
# unbound / https-dns-proxy 已移除（DNS 用 MosDNS / AdGuard Home / SmartDNS）
# CONFIG_PACKAGE_luci-app-unbound is not set
# CONFIG_PACKAGE_luci-i18n-unbound-zh-cn is not set
# 其他
# CONFIG_PACKAGE_luci-app-qosify is not set
# CONFIG_PACKAGE_luci-i18n-qosify-zh-cn is not set
# 多拨（依赖 mwan3 + macvlan；界面本身是中文，没有单独的中文包）
CONFIG_PACKAGE_luci-app-syncdial=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y
# CONFIG_PACKAGE_luci-app-gost is not set
# CONFIG_PACKAGE_luci-i18n-gost-zh-cn is not set
# CONFIG_PACKAGE_luci-app-microsocks is not set
# CONFIG_PACKAGE_luci-i18n-microsocks-zh-cn is not set
# CONFIG_PACKAGE_luci-app-rtp2httpd is not set
# CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn is not set
# AirPlay 2 已移除：ImmortalWrt 的 shairport-sync 4.3.6 和新版 FFmpeg 编译不过（AVCodec.sample_fmts 已删除）
# CONFIG_PACKAGE_luci-app-airplay2 is not set
# CONFIG_PACKAGE_luci-i18n-airplay2-zh-cn is not set
# CONFIG_PACKAGE_shairport-sync-openssl is not set
# CONFIG_PACKAGE_shairport-sync-mbedtls is not set
# CONFIG_PACKAGE_shairport-sync-mini is not set
# CONFIG_PACKAGE_luci-app-mosquitto is not set
# CONFIG_PACKAGE_luci-i18n-mosquitto-zh-cn is not set
# 只装防火墙封禁端（bouncer），不含 CrowdSec 引擎，需要另外有一个 CrowdSec 本地 API
# CONFIG_PACKAGE_luci-app-crowdsec-firewall-bouncer is not set
# CONFIG_PACKAGE_luci-i18n-crowdsec-firewall-bouncer-zh-cn is not set
# CONFIG_PACKAGE_luci-app-snmpd is not set
# CONFIG_PACKAGE_luci-i18n-snmpd-zh-cn is not set
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_luci-i18n-lldpd-zh-cn=y
